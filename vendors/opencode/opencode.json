{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "go test *": "allow",
      "go build *": "allow",
      "go vet *": "allow",
      "go fmt *": "allow",
      "make test *": "allow",
      "make lint *": "allow",
      "make build *": "allow",
      "npm run test *": "allow",
      "npm run typecheck *": "allow",
      "npm run lint *": "allow",
      "npm test *": "allow",
      "yarn run test *": "allow",
      "yarn run typecheck *": "allow",
      "yarn run lint *": "allow",
      "yarn test *": "allow",
      "pnpm run test *": "allow",
      "pnpm run typecheck *": "allow",
      "pnpm run lint *": "allow",
      "pnpm test *": "allow",
      "bun run test *": "allow",
      "bun run typecheck *": "allow",
      "bun run lint *": "allow",
      "bun test *": "allow",
      "tsc --noEmit *": "allow",
      "eslint *": "allow",
      "prettier --check *": "allow",
      "cargo check *": "allow",
      "cargo clippy *": "allow",
      "cargo test *": "allow",
      "cargo fmt --check *": "allow",
      "python -m pytest *": "allow",
      "python -m mypy *": "allow",
      "python3 -m pytest *": "allow",
      "python3 -m mypy *": "allow",
      "git stash show *": "allow",
      "git worktree list *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "grep *": "allow",
      "git commit *": "ask",
      "git add *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git pull *": "ask",
      "git fetch *": "ask",
      "gh pr create *": "ask",
      "gh pr merge *": "ask",
      "gh pr comment *": "ask",
      "gh pr edit *": "ask",
      "gh pr close *": "ask",
      "gh issue create *": "ask",
      "gh issue comment *": "ask",
      "gh issue edit *": "ask",
      "gh issue close *": "ask",
      "docker pull *": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker build *": "ask",
      "npm install *": "ask",
      "yarn install *": "ask",
      "pnpm install *": "ask",
      "bun install *": "ask",
      "pip install *": "ask",
      "npm login *": "ask",
      "docker login *": "ask",
      "rm -rf *": "deny",
      "gh auth *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/*.key": "deny"
    }
  },
  "formatter": true
}
