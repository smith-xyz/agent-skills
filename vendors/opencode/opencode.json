{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git add *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git pull *": "ask",
      "git fetch *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git checkout *": "ask",
      "gh pr create *": "ask",
      "gh pr merge *": "ask",
      "gh pr comment *": "ask",
      "gh pr edit *": "ask",
      "gh pr close *": "ask",
      "gh issue create *": "ask",
      "gh issue comment *": "ask",
      "gh issue edit *": "ask",
      "gh issue close *": "ask",
      "docker pull *": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker build *": "ask",
      "docker login *": "ask",
      "npm install *": "ask",
      "yarn install *": "ask",
      "pnpm install *": "ask",
      "bun install *": "ask",
      "pip install *": "ask",
      "npm login *": "ask",
      "rm *": "ask",
      "rm -rf *": "deny",
      "gh auth *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/*.key": "deny"
    },
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "~/.agent-skills/**": "allow",
      "~/agent-workspace/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "skill": "allow"
  },
  "formatter": true
}
