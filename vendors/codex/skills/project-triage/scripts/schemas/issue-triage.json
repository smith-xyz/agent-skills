{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IssueTriage",
  "description": "Output schema for the issue-triage subagent",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["number", "current_labels", "add_labels", "remove_labels", "confidence", "rationale"],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "description": "GitHub issue number"
          },
          "current_labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Labels currently on the issue"
          },
          "add_labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Labels to add — MUST exist in the labels table"
          },
          "remove_labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Labels to remove"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence in the recommendation (0-1)"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Brief explanation for the label changes"
          },
          "comment_signal": {
            "type": "string",
            "description": "Summary of any new comment that influenced the triage"
          }
        }
      }
    }
  }
}
