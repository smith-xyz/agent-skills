        "properties": {
          "number": { "type": "integer" },
          "recommendation": {
            "type": "string",
            "enum": ["REVIEW", "CLOSE", "MERGE-READY"]
          },
          "close_reason": { "type": "string" },
          "linked_issue": { "type": "integer" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "quality_notes": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "duplicate_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": { "type": "integer" },
          "prs": { "type": "array", "items": { "type": "integer" } },
          "winner": { "type": "integer" }
        }
      }
    }
  },
  "additionalProperties": false
}
