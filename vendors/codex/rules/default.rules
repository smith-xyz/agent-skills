# Execpolicy rules — mirrors Claude Code permissions from settings/claude.json.
# Starlark format: prefix_rule(pattern, decision, justification)

# === Allow: build, test, lint, format checks ===

prefix_rule(pattern = ["go", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["go", "build"], decision = "allow", justification = "Build")
prefix_rule(pattern = ["go", "vet"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["go", "fmt"], decision = "allow", justification = "Format check")
prefix_rule(pattern = ["make", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["make", "lint"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["make", "build"], decision = "allow", justification = "Build")

prefix_rule(pattern = ["npm", "run", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["npm", "run", "typecheck"], decision = "allow", justification = "Type check")
prefix_rule(pattern = ["npm", "run", "lint"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["npm", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["yarn", "run", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["yarn", "run", "typecheck"], decision = "allow", justification = "Type check")
prefix_rule(pattern = ["yarn", "run", "lint"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["yarn", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["pnpm", "run", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["pnpm", "run", "typecheck"], decision = "allow", justification = "Type check")
prefix_rule(pattern = ["pnpm", "run", "lint"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["pnpm", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["bun", "run", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["bun", "run", "typecheck"], decision = "allow", justification = "Type check")
prefix_rule(pattern = ["bun", "run", "lint"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["bun", "test"], decision = "allow", justification = "Test runner")

prefix_rule(pattern = ["tsc", "--noEmit"], decision = "allow", justification = "Type check")
prefix_rule(pattern = ["eslint"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["prettier", "--check"], decision = "allow", justification = "Format check")

prefix_rule(pattern = ["cargo", "check"], decision = "allow", justification = "Build check")
prefix_rule(pattern = ["cargo", "clippy"], decision = "allow", justification = "Linter")
prefix_rule(pattern = ["cargo", "test"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["cargo", "fmt", "--check"], decision = "allow", justification = "Format check")

prefix_rule(pattern = ["python", "-m", "pytest"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["python", "-m", "mypy"], decision = "allow", justification = "Type check")
prefix_rule(pattern = ["python3", "-m", "pytest"], decision = "allow", justification = "Test runner")
prefix_rule(pattern = ["python3", "-m", "mypy"], decision = "allow", justification = "Type check")

prefix_rule(pattern = ["git", "stash", "show"], decision = "allow", justification = "Read-only git")
prefix_rule(pattern = ["git", "worktree", "list"], decision = "allow", justification = "Read-only git")

# === Deny: destructive operations ===

prefix_rule(pattern = ["rm", "-rf"], decision = "deny", justification = "Destructive")
prefix_rule(pattern = ["gh", "auth"], decision = "deny", justification = "Auth mutation")

# === Prompt: git mutations, docker, package installs ===

prefix_rule(pattern = ["git", "commit"], decision = "prompt", justification = "Git mutation")
prefix_rule(pattern = ["git", "add"], decision = "prompt", justification = "Git mutation")
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Git mutation")
prefix_rule(pattern = ["git", "merge"], decision = "prompt", justification = "Git mutation")
prefix_rule(pattern = ["git", "rebase"], decision = "prompt", justification = "Git mutation")
prefix_rule(pattern = ["git", "pull"], decision = "prompt", justification = "Git mutation")
prefix_rule(pattern = ["git", "fetch"], decision = "prompt", justification = "Git mutation")

prefix_rule(pattern = ["gh", "pr", "create"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "pr", "comment"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "pr", "edit"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "pr", "close"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "issue", "create"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "issue", "comment"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "issue", "edit"], decision = "prompt", justification = "GitHub mutation")
prefix_rule(pattern = ["gh", "issue", "close"], decision = "prompt", justification = "GitHub mutation")

prefix_rule(pattern = ["docker", "pull"], decision = "prompt", justification = "Docker operation")
prefix_rule(pattern = ["docker", "run"], decision = "prompt", justification = "Docker operation")
prefix_rule(pattern = ["docker", "exec"], decision = "prompt", justification = "Docker operation")
prefix_rule(pattern = ["docker", "build"], decision = "prompt", justification = "Docker operation")

prefix_rule(pattern = ["npm", "install"], decision = "prompt", justification = "Package install")
prefix_rule(pattern = ["yarn", "install"], decision = "prompt", justification = "Package install")
prefix_rule(pattern = ["pnpm", "install"], decision = "prompt", justification = "Package install")
prefix_rule(pattern = ["bun", "install"], decision = "prompt", justification = "Package install")
prefix_rule(pattern = ["pip", "install"], decision = "prompt", justification = "Package install")

prefix_rule(pattern = ["npm", "login"], decision = "prompt", justification = "Auth operation")
prefix_rule(pattern = ["docker", "login"], decision = "prompt", justification = "Auth operation")
