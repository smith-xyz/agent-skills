{
  "chat.permissions.default": "default",
  "chat.agent.sandbox.enabled": "on",

  // Allow agent scratch under ~/agent-workspace without prompts.
  "chat.agent.sandbox.fileSystem.mac": {
    "allowRead": ["~/agent-workspace"],
    "allowWrite": ["~/agent-workspace"]
  },
  "chat.agent.sandbox.fileSystem.linux": {
    "allowRead": ["~/agent-workspace"],
    "allowWrite": ["~/agent-workspace"]
  },

  // Protect reflect config/hooks from silent agent edits.
  "chat.tools.edits.autoApprove": {
    "**/agent-workspace/**": true,
    "**/.agent-skills/**": false,
    "**/.copilot/hooks/**": false,
    "**/.claude/settings.json": false,
    "**/.github/hooks/**": false,
    "**/shared/hooks/**": false,
    "**/tools/reflect/**": false
  },

  "chat.tools.terminal.autoApprove": {
    "/^go (test|build|vet|fmt)/": true,
    "/^make (test|lint|build)/": true,
    "/^npm (run test|run typecheck|run lint|test)/": true,
    "/^yarn (run test|run typecheck|run lint|test)/": true,
    "/^pnpm (run test|run typecheck|run lint|test)/": true,
    "/^bun (run test|run typecheck|run lint|test)/": true,
    "/^tsc --noEmit/": true,
    "/^eslint/": true,
    "/^prettier --check/": true,
    "/^cargo (check|clippy|test|fmt --check)/": true,
    "/^python3? -m (pytest|mypy)/": true,
    "/^git (stash show|worktree list)/": true,
    "rm": false,
    "rmdir": false,
    "/^rm -rf/": false,
    "/^gh auth/": false
  }
}
