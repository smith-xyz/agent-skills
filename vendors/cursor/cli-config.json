{
  "version": 1,
  "permissions": {
    "allow": [
      "Shell(go test)",
      "Shell(go build)",
      "Shell(go vet)",
      "Shell(go fmt)",
      "Shell(make test)",
      "Shell(make lint)",
      "Shell(make build)",
      "Shell(npm run test)",
      "Shell(npm run typecheck)",
      "Shell(npm run lint)",
      "Shell(npm test)",
      "Shell(yarn run test)",
      "Shell(yarn run typecheck)",
      "Shell(yarn run lint)",
      "Shell(yarn test)",
      "Shell(pnpm run test)",
      "Shell(pnpm run typecheck)",
      "Shell(pnpm run lint)",
      "Shell(pnpm test)",
      "Shell(bun run test)",
      "Shell(bun run typecheck)",
      "Shell(bun run lint)",
      "Shell(bun test)",
      "Shell(tsc --noEmit)",
      "Shell(eslint)",
      "Shell(prettier --check)",
      "Shell(cargo check)",
      "Shell(cargo clippy)",
      "Shell(cargo test)",
      "Shell(cargo fmt --check)",
      "Shell(python -m pytest)",
      "Shell(python -m mypy)",
      "Shell(python3 -m pytest)",
      "Shell(python3 -m mypy)",
      "Shell(git stash show)",
      "Shell(git worktree list)",
      "Read(~/agent-workspace/**)",
      "Write(~/agent-workspace/**)",
      "Mcp(github:*)",
      "Mcp(atlassian:*)",
      "Mcp(kubernetes:*)",
      "Mcp(context7:*)",
      "Mcp(terraform:*)",
      "Mcp(digitalocean:*)",
      "Mcp(aws:*)"
    ],
    "deny": [
      "Shell(rm -rf)",
      "Shell(gh auth)",
      "Read(.env*)",
      "Write(**/*.key)"
    ]
  }
}
