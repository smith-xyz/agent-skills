{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BacklogPlanner",
  "description": "Output schema for the backlog-planner subagent",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["number", "effort", "confidence", "area"],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "description": "GitHub issue number"
          },
          "effort": {
            "type": "string",
            "enum": ["quick-fix", "medium", "large"],
            "description": "Estimated fix effort"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence in effort classification"
          },
          "area": {
            "type": "string",
            "description": "Primary area of the codebase affected"
          },
          "drivers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Database drivers affected"
          },
          "fix_plan": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "description": "Primary file to change"
              },
              "approach": {
                "type": "string",
                "description": "1-2 sentence fix strategy"
              },
              "test": {
                "type": "string",
                "description": "Test file/directory to create or update"
              },
              "branch": {
                "type": "string",
                "description": "Suggested branch name"
              }
            },
            "required": ["file", "approach"],
            "additionalProperties": false
          },
          "related_issues": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Issue numbers that could share a PR"
          }
        }
      }
    }
  }
}
