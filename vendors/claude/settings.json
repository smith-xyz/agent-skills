{
  "model": "opus",
  "alwaysThinkingEnabled": false,
  "skipDangerousModePermissionPrompt": false,
  "permissions": {
    "additionalDirectories": [
      "~/agent-workspace"
    ],
    "allow": [
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go fmt -l *)",
      "Bash(make test *)",
      "Bash(make lint *)",
      "Bash(make build *)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm test *)",
      "Bash(yarn run test *)",
      "Bash(yarn run typecheck *)",
      "Bash(yarn run lint *)",
      "Bash(yarn test *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm test *)",
      "Bash(bun run test *)",
      "Bash(bun run typecheck *)",
      "Bash(bun run lint *)",
      "Bash(bun test *)",
      "Bash(tsc --noEmit *)",
      "Bash(eslint *)",
      "Bash(prettier --check *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt --check *)",
      "Bash(python -m pytest *)",
      "Bash(python -m mypy *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m mypy *)",
      "Bash(git stash show *)",
      "Bash(git worktree list *)",
      "Read(~/agent-workspace/**)",
      "Edit(~/agent-workspace/**)",
      "Write(~/agent-workspace/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(gh auth *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh auth *)",
      "Bash(docker pull *)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker build *)",
      "Bash(npm install *)",
      "Bash(yarn install *)",
      "Bash(pnpm install *)",
      "Bash(bun install *)",
      "Bash(pip install *)",
      "Bash(npm login *)",
      "Bash(docker login *)"
    ]
  }
}
