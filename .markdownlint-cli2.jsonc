{
  // Use .gitignore patterns (includes .test/, .work/)
  "gitignore": true,
  
  // Rule configuration
  "config": {
    "default": true,
    // Allow long lines (code blocks, tables)
    "MD013": false,
    // Allow duplicate headings in different sections
    "MD024": {
      "siblings_only": true
    },
    // Allow inline HTML
    "MD033": false,
    // Allow bare URLs
    "MD034": false
  }
}
